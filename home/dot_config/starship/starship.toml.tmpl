add_newline = false
# Minimal left prompt, everything else on the right
format = """$directory$character"""
right_format = """$all"""
command_timeout = 1000
palette = "catppuccin_mocha"

[character]
vicmd_symbol = "[N] >>>"
success_symbol = '[❯](bold green)'
error_symbol = '[❯](bold red)'

[directory]
truncation_length = 2
truncate_to_repo = false

[git_branch]
format = '[$symbol$branch(:$remote_branch)]($style) '

{{ if .work -}}
[kubernetes]
disabled = false
format = '[$symbol$context( / $namespace)]($style) '

# Private aliases take precedence over the generic environment colors below.
{{ $contextAliases := joinPath .chezmoi.homeDir ".config" "starship" "kubernetes-contexts.toml" -}}
{{ if stat $contextAliases -}}
{{ include $contextAliases }}
{{ end -}}

[[kubernetes.contexts]]
context_pattern = '(.*[._-])?(stg|staging)[._-].*'
style = 'bold yellow'

[[kubernetes.contexts]]
context_pattern = '(.*[._-])?(prd|prod|production)[._-].*'
style = 'bold red'
{{ end }}

[golang]
format = '[ ](bold cyan)'

