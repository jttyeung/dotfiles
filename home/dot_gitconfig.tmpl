[core]
  editor = code --wait
  excludesfile = ~/.gitignore_global
  hooksPath = ~/.config/git/hooks

# Identity (name, email) lives in ~/.config/git/identity.local, outside the dotfiles repository.
[include]
  path = ~/.config/git/identity.local
[pull]
	ff = only
[init]
	defaultBranch = main
[credential]
	helper = osxkeychain
[url "git@github.com:"]
	insteadOf = https://github.com/

{{ if .work -}}
# Work identity is configured locally, outside the dotfiles repository.
[include]
  path = ~/.config/git/work.local
{{ end -}}
