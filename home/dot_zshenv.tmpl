# Keep PATH/FPATH free of duplicates. `brew shellenv` prepends to FPATH (which is
# exported) every time it runs, so nested shells grow it, which changes the
# compinit cache key and forces a slow full rebuild of ~/.zcompdump.
typeset -U path fpath

export PATH=/usr/local/bin/:$PATH

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Setup GOPATH
export GOPATH=$HOME/go
export PATH="/usr/local/go/bin:$GOPATH/bin:$PATH"

# SQLite
export PATH="/usr/local/opt/sqlite/bin:$PATH"

# Mise
export PATH="$HOME/.local/share/mise/shims:$PATH"
{{- if .work }}

# for ruby
export PATH=$PATH:$HOME/.gem/bin

# Kubernetes kubectl plugins with krew
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# kubeconfig
export KUBECONFIG=$HOME/.kube/config

# Python3
export PATH="/Library/Frameworks/Python.framework/Versions/3.10/bin:${PATH}"
{{- end }}
