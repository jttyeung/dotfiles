##################################################

# Homebrew completions: only extend fpath here. oh-my-zsh (sourced below)
# runs compinit itself; calling it here too doubles the startup cost.
# https://docs.brew.sh/Shell-Completion
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
########## User configurations ##########

# zoxide (z / zi)
eval "$(zoxide init zsh)"

########## ZSH Default configurations ##########

ZSH_DISABLE_COMPFIX=true

# Prompt is provided by starship (initialised at the bottom).
ZSH_THEME=""

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion. Case
# sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# The optional three formats: "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# HIST_STAMPS="mm/dd/yyyy"

# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  git
  golang
  bundler
  httpie
)

export ZSH="$HOME/.oh-my-zsh"
source "$ZSH/oh-my-zsh.sh"
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

{{ if .work -}}
# kubeswitch must run as a shell function so it can update this pane's KUBECONFIG.
if command -v switcher >/dev/null 2>&1; then
  source <(switcher init zsh)
  source <(switch completion zsh)
fi
{{ end }}

# Starship prompt (config: ~/.config/starship/starship.toml)
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
eval "$(starship init zsh)"

# git worktrees with tmux sessions
# usage: wf <branch> [claude|codex]
wf() {
  local branch=$1 agent=$2
  if [[ -z $branch || -z $agent ]]; then
    echo "usage: wf <branch> <claude|codex|shell>" >&2
    return 1
  fi
  case $agent in
    claude|codex|shell) ;;
    *) echo "wf: unknown agent '$agent' (use claude, codex, or shell)" >&2
       return 1 ;;
  esac

  local repo=$(basename "$(git rev-parse --show-toplevel)")
  local safe=${branch//\//-}
  local dir="../${repo}-${safe}"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    [[ -d $dir ]] || git worktree add "$dir" "$branch" || return 1
  else
    git worktree add "$dir" -b "$branch" origin/main || return 1
  fi

  if ! tmux has-session -t "$safe" 2>/dev/null; then
    tmux new-session -d -s "$safe" -c "$dir"
    [[ $agent == shell ]] || tmux send-keys -t "$safe" "$agent" C-m
  fi

  if [[ -n $TMUX ]]; then
    tmux switch-client -t "$safe"
  else
    tmux attach -t "$safe"
  fi
}
