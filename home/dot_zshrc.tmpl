##################################################

# Homebrew completions: only extend fpath here. oh-my-zsh (sourced below)
# runs compinit itself; calling it here too doubles the startup cost.
# https://docs.brew.sh/Shell-Completion
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
########## User configurations ##########

# Every process spawn is slow here (endpoint security scans each exec), so
# `eval "$(tool init zsh)"` is expensive. Cache each tool's init output and
# only regenerate it when the tool's binary is newer than the cache.
# usage: _cached_source <name> <binary> <command...>
_cached_source() {
  local name=$1 bin=$(whence -p "$2") dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
  shift 2
  [[ -n $bin ]] || return 1
  local cache="$dir/init-$name.zsh"
  if [[ ! -s $cache || $bin -nt $cache ]]; then
    mkdir -p "$dir" && "$@" >| "$cache" || { rm -f "$cache"; return 1 }
  fi
  source "$cache"
}

# zoxide (z / zi)
_cached_source zoxide zoxide zoxide init zsh

########## ZSH Default configurations ##########

ZSH_DISABLE_COMPFIX=true

# Don't let oh-my-zsh check for updates at startup; update it by hand.
zstyle ':omz:update' mode disabled

# Prompt is provided by starship (initialised at the bottom).
ZSH_THEME=""

plugins=(
  git
  golang
)

export ZSH="$HOME/.oh-my-zsh"
source "$ZSH/oh-my-zsh.sh"
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

{{ if .work -}}
# kubeswitch must run as a shell function so it can update this pane's KUBECONFIG.
if (( $+commands[switcher] )); then
  _cached_source switcher switcher switcher init zsh
  # `switch` only exists once the init script above has been sourced.
  _cached_source switch-completion switcher switch completion zsh
  alias kubeswitch=switch
fi
{{ else -}}
# libpq is keg-only; put its client tools (psql, pg_dump) on PATH.
export PATH="$(brew --prefix libpq)/bin:$PATH"
{{ end }}

# Starship prompt (config: ~/.config/starship/starship.toml)
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
_cached_source starship starship starship init zsh

# git worktrees with tmux sessions
# usage: wf <branch> [claude|codex]
wf() {
  local branch=$1 agent=$2
  if [[ -z $branch || -z $agent ]]; then
    echo "usage: wf <branch> <claude|codex|shell>" >&2
    return 1
  fi
  case $agent in
    claude|codex|shell) ;;
    *) echo "wf: unknown agent '$agent' (use claude, codex, or shell)" >&2
       return 1 ;;
  esac

  local repo=$(basename "$(git rev-parse --show-toplevel)")
  local safe=${branch//\//-}
  local dir="../${repo}-${safe}"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    [[ -d $dir ]] || git worktree add "$dir" "$branch" || return 1
  else
    git worktree add "$dir" -b "$branch" origin/main || return 1
  fi

  if ! tmux has-session -t "$safe" 2>/dev/null; then
    tmux new-session -d -s "$safe" -c "$dir"
    [[ $agent == shell ]] || tmux send-keys -t "$safe" "$agent" C-m
  fi

  if [[ -n $TMUX ]]; then
    tmux switch-client -t "$safe"
  else
    tmux attach -t "$safe"
  fi
}

# User-installed CLIs live here
export PATH="$HOME/.local/bin:$PATH"
